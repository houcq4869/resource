diff --git a/common/platform/pm/pm_hi35xx.c b/common/platform/pm/pm_hi35xx.c
new file mode 100644
index 00000000..1f42fa26
--- /dev/null
+++ b/common/platform/pm/pm_hi35xx.c
@@ -0,0 +1,190 @@
+/*
+ * Copyright (c) 2026 HiSilicon (Shanghai) Technologies CO., LIMITED.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * AOV PoC 平台电源管理钩子（阶段4 K4/B1 第一步）
+ *
+ * 1. 覆写内核 WEAK OsIdleTask：无 PM 锁时自动进入 LOS_PmSuspend
+ *    （休眠自动进入机制，whole-archive 链接保证 strong 符号生效）；
+ *    SMP 从核保持 WFI park（从核深睡 park 为阶段4第三步课题）。
+ * 2. 注册 LosPmSysctrl：early/late 挂 suspend/resume 耗时计量，
+ *    normal/lightSuspend 第一阶段为静默 WFI（时钟门控/DDR 序列待
+ *    CRG/PMU 资料后在本文件填充，见方案设计 B1）。
+ * 3. 休眠档位经既有 /proc/power/power_mode 切换（normal/light/deep），
+ *    PM 锁经 /proc/power/power_lock（powermgr_lite RunningLock 已对接）。
+ */
+
+#include "los_pm.h"
+#include "los_sys.h"
+#include "los_printf.h"
+#include "los_hw_cpu.h"
+#include "hal_timer.h"
+#include "los_sys_pri.h"
+
+#ifdef LOSCFG_KERNEL_PM
+
+#define PM_STAT_DUMP_PERIOD 64
+#define PM_CYCLES_PER_SEC   (OS_CYCLE_PER_TICK * LOSCFG_BASE_CORE_TICK_PER_SECOND)
+
+STATIC UINT32 g_pmSuspendCount = 0;
+STATIC UINT32 g_pmSuspendTotalMs = 0;
+STATIC UINT32 g_pmSuspendMaxMs = 0;
+STATIC UINT32 g_pmEarlyTick = 0;
+STATIC BOOL g_pmSysctrlInited = FALSE;
+
+/* AOV T4b：DEEP 休眠时间 offset 补偿。RTC epoch 读取由 rtc 驱动导出（weak 引用，
+ * 未编入 rtc 驱动的平台自动退化为不补偿）。S2 修复后时序：early（可睡眠）采集
+ * RTC/CNTPCT 起点 → deepSuspend 仅 WFI（关中断临界区）→ late（非临界区）读 RTC
+ * 终点并叠加 offset。第一阶段 deepSuspend=WFI+计时框架（CNTPCT 不停走，offset
+ * 增量≈0，机制自校验）；第三步真实电源域关断（CNTPCT 掉电）后由 RTC 差值补偿
+ * 丢失 cycles，保证录像时间轴跨深睡连续。 */
+extern int Hi35xxRtcReadEpoch(long long *epochSec) __attribute__((weak));
+
+STATIC UINT64 g_pmDeepStartCycle = 0;
+STATIC long long g_pmDeepStartEpoch = -1;
+
+STATIC UINT32 HiPmEarlySuspend(UINT32 mode)
+{
+    g_pmEarlyTick = (UINT32)LOS_TickCountGet();
+    /* Fixes: Kimi/02_代码审查报告.md #S2 (2026-09-17)
+     * deep 档的 RTC epoch 读取（SPI+OsalMSleep，可睡眠）必须在 early 完成——
+     * early 运行于可睡眠上下文；deepSuspend/deepResume 处于关中断+持锁
+     * 临界区，只允许寄存器级操作（见 los_pm.h LosPmSysctrl 上下文契约）。 */
+    if (mode == LOS_SYS_DEEP_SLEEP) {
+        g_pmDeepStartCycle = HalClockGetCycles();
+        g_pmDeepStartEpoch = -1;
+        if (Hi35xxRtcReadEpoch != NULL) {
+            (VOID)Hi35xxRtcReadEpoch(&g_pmDeepStartEpoch);
+        }
+    }
+    return LOS_OK;
+}
+
+/* S2：offset 补偿在 late 执行（S1 修复后 late 位于非临界区，可睡眠）。
+ * 注意：唤醒到本函数执行之间存在极小窗口，期间读取的时间不含睡眠时长，
+ * 对 1fps 值守业务无影响；第三步正式深睡时如需严格时序，可在
+ * deepResume 内用寄存器快照做最小修正。 */
+STATIC VOID HiPmDeepOffsetApply(VOID)
+{
+    long long epochNow = -1;
+    UINT64 elapsedCycle;
+    UINT64 rtcElapsedCycle;
+
+    if ((g_pmDeepStartEpoch < 0) || (Hi35xxRtcReadEpoch == NULL)) {
+        return;
+    }
+    if (Hi35xxRtcReadEpoch(&epochNow) != 0) {
+        return;
+    }
+    elapsedCycle = HalClockGetCycles() - g_pmDeepStartCycle;
+    rtcElapsedCycle = (UINT64)(epochNow - g_pmDeepStartEpoch) * PM_CYCLES_PER_SEC;
+    if (rtcElapsedCycle > elapsedCycle) {
+        LOS_PmTimeOffsetAdd(rtcElapsedCycle - elapsedCycle);
+        PRINTK("[AOV-PM] deep resume: offset +%u cycles (rtc %ds)\n",
+            (UINT32)(rtcElapsedCycle - elapsedCycle), (int)(epochNow - g_pmDeepStartEpoch));
+    }
+}
+
+STATIC VOID HiPmLateResume(UINT32 mode)
+{
+    UINT32 cost;
+
+    cost = (UINT32)LOS_TickCountGet() - g_pmEarlyTick;
+    if (mode == LOS_SYS_DEEP_SLEEP) {
+        HiPmDeepOffsetApply();
+    }
+    g_pmSuspendCount++;
+    g_pmSuspendTotalMs += cost;
+    if (cost > g_pmSuspendMaxMs) {
+        g_pmSuspendMaxMs = cost;
+    }
+    if ((g_pmSuspendCount % PM_STAT_DUMP_PERIOD) == 0) {
+        PRINTK("[AOV-PM] suspends=%u last=%ums avg=%ums max=%ums locks=%u\n",
+            g_pmSuspendCount, cost, g_pmSuspendTotalMs / g_pmSuspendCount,
+            g_pmSuspendMaxMs, LOS_PmLockCountGet());
+    }
+}
+
+STATIC UINT32 HiPmNormalSuspend(VOID)
+{
+    WFI;
+    return LOS_OK;
+}
+
+/* 第一阶段 light 实现：完整 sysctrl 时序 + WFI；时钟门控序列留待 CRG 资料 */
+STATIC UINT32 HiPmLightSuspend(VOID)
+{
+    WFI;
+    return LOS_OK;
+}
+
+STATIC UINT32 HiPmDeepSuspend(VOID)
+{
+    /* S2：本函数运行于关中断+持 g_pmSpin 临界区，只允许寄存器级操作。
+     * RTC epoch 起点已在 HiPmEarlySuspend 采集；offset 补偿在 HiPmLateResume。 */
+    /* 第三步在此插入电源域关断序列（依赖海思低功耗 SDK，NDA） */
+    WFI;
+    return LOS_OK;
+}
+
+STATIC VOID HiPmDeepResume(VOID)
+{
+    /* S2：关中断临界区，不执行任何可睡眠操作；时间补偿已由 late 钩子处理 */
+}
+
+STATIC LosPmSysctrl g_hiPmSysctrl = {
+    .early          = HiPmEarlySuspend,
+    .late           = HiPmLateResume,
+    .normalSuspend  = HiPmNormalSuspend,
+    .lightSuspend   = HiPmLightSuspend,
+    .deepSuspend    = HiPmDeepSuspend,
+    .deepResume     = HiPmDeepResume,
+};
+
+STATIC VOID HiPmSysctrlRegister(VOID)
+{
+    UINT32 ret;
+
+    if (g_pmSysctrlInited) {
+        return;
+    }
+    g_pmSysctrlInited = TRUE;
+    ret = LOS_PmRegister(LOS_PM_TYPE_SYSCTRL, &g_hiPmSysctrl);
+    PRINTK("[AOV-PM] sysctrl registered ret=0x%x, mode switch: /proc/power/power_mode\n", ret);
+}
+
+LITE_OS_SEC_TEXT VOID OsIdleTask(VOID)
+{
+#ifdef LOSCFG_KERNEL_SMP
+    if (ArchCurrCpuid() != 0) {
+        while (1) {
+            WFI;
+        }
+    }
+#endif
+
+    /* idle 任务在内核模块初始化（含 OsPmInit）完成后才运行，注册时序安全 */
+    HiPmSysctrlRegister();
+
+    while (1) {
+        /* K1 分档锁：Suspend 内部完成分档否决/降级与竞态二次检查；
+         * NORMAL 档被否决（返回 NOK）时退化为裸 WFI（与基线行为一致） */
+        if (LOS_PmSuspend(0) != LOS_OK) {
+            WFI;
+        }
+    }
+}
+
+#endif /* LOSCFG_KERNEL_PM */
diff --git a/common/platform/rtc/rtc_hi35xx.c b/common/platform/rtc/rtc_hi35xx.c
index 994ef614..ba9084fb 100644
--- a/common/platform/rtc/rtc_hi35xx.c
+++ b/common/platform/rtc/rtc_hi35xx.c
@@ -23,6 +23,7 @@
 #include "rtc_base.h"
 #include "rtc_core.h"
 #include "rtc_hi35xx.h"
+#include <sys/time.h>
 
 #define HDF_LOG_TAG rtc_hi35xx
 
@@ -798,6 +799,147 @@ static int32_t HiRtcBind(struct HdfDeviceObject *device)
     return HDF_SUCCESS;
 }
 
+/* ==== AOV PoC T4：开机 RTC→系统时间校时 + NTP 校时后系统时间→RTC 回写 ==== */
+#define RTC_TIME_YEAR_START      1970
+#define RTC_TIME_YEAR_END        2099
+#define SEC_PER_MIN              60
+#define SEC_PER_HOUR             3600
+#define SEC_PER_DAY              86400
+#define USEC_PER_MSEC            1000
+#define DAYS_PER_WEEK            7
+#define RTC_WEEKDAY_EPOCH_OFFSET 3  /* 1970-01-01 为周四，(days+3)%7+1 → 1-7=Mon-Sun */
+
+static struct RtcHost *g_rtcTimeSyncHost = NULL;
+
+/* civil <-> epoch 天数互转（Howard Hinnant 算法），不依赖内核侧 mktime/gmtime */
+static long long HiRtcCivilToDays(long long y, long long m, long long d)
+{
+    long long era;
+    unsigned int yoe;
+    unsigned int doy;
+    unsigned int doe;
+
+    y -= (m <= 2) ? 1 : 0;
+    era = (y >= 0 ? y : y - 399) / 400;              /* [0,146097) 天为一个 era */
+    yoe = (unsigned int)(y - era * 400);             /* [0,399] */
+    doy = (unsigned int)(153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + (unsigned int)d - 1; /* [0,365] */
+    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;     /* [0,146096] */
+    return era * 146097 + (long long)doe - 719468;   /* 1970-01-01 = 0 */
+}
+
+static void HiRtcDaysToCivil(long long z, long long *y, long long *m, long long *d)
+{
+    long long era;
+    long long yy;
+    unsigned int doe;
+    unsigned int yoe;
+    unsigned int doy;
+    unsigned int mp;
+    unsigned int mm;
+
+    z += 719468;
+    era = (z >= 0 ? z : z - 146096) / 146097;
+    doe = (unsigned int)(z - era * 146097);          /* [0,146096] */
+    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; /* [0,399] */
+    yy = (long long)yoe + era * 400;
+    doy = doe - (365 * yoe + yoe / 4 - yoe / 100);   /* [0,365] */
+    mp = (5 * doy + 2) / 153;                        /* [0,11], 0=Mar */
+    *d = (long long)(doy - (153 * mp + 2) / 5 + 1);
+    mm = mp + (mp < 10 ? 3 : (unsigned int)-9);      /* [1,12] */
+    *m = (long long)mm;
+    *y = yy + (mm <= 2 ? 1 : 0);
+}
+
+static void HiRtcSyncSystemTime(struct RtcHost *host)
+{
+    struct RtcTime rt;
+    struct timeval tv;
+    long long days;
+
+    if (HiRtcReadTime(host, &rt) != HDF_SUCCESS) {
+        HDF_LOGE("[AOV-TIME] boot sync: read rtc fail");
+        return;
+    }
+    if (rt.year < RTC_TIME_YEAR_START || rt.year > RTC_TIME_YEAR_END) {
+        HDF_LOGI("[AOV-TIME] boot sync skipped: rtc not set (year=%u)", rt.year);
+        return;
+    }
+    /* Fixes: Kimi/02_代码审查报告.md #M4 (2026-09-17)
+     * RTC 寄存器可能读出越界字段（掉电/未初始化），全部校验避免算出垃圾时间 */
+    if (rt.month < 1 || rt.month > 12 || rt.day < 1 || rt.day > 31 ||
+        rt.hour > 23 || rt.minute > 59 || rt.second > 59) {
+        HDF_LOGI("[AOV-TIME] boot sync skipped: invalid rtc fields (%u-%u-%u %u:%u:%u)",
+            rt.year, rt.month, rt.day, rt.hour, rt.minute, rt.second);
+        return;
+    }
+    days = HiRtcCivilToDays(rt.year, rt.month, rt.day);
+    tv.tv_sec = (time_t)(days * SEC_PER_DAY + rt.hour * SEC_PER_HOUR + rt.minute * SEC_PER_MIN + rt.second);
+    tv.tv_usec = (suseconds_t)((unsigned int)rt.millisecond * USEC_PER_MSEC);
+    if (settimeofday(&tv, NULL) == 0) {
+        HDF_LOGI("[AOV-TIME] boot sync ok: %u-%u-%u %u:%u:%u",
+            rt.year, rt.month, rt.day, rt.hour, rt.minute, rt.second);
+    } else {
+        HDF_LOGE("[AOV-TIME] boot sync: settimeofday fail");
+    }
+}
+
+/* 供 lwip SNTP 校时回调弱引用调用（sntp_port.c LwipSntpSetSystemTime）：系统时间→RTC */
+int Hi35xxRtcWriteSysTime(void)
+{
+    struct RtcTime rt = {0};
+    struct timeval tv;
+    long long y;
+    long long m;
+    long long d;
+    long long days;
+    unsigned int rem;
+
+    if (g_rtcTimeSyncHost == NULL) {
+        return HDF_FAILURE;
+    }
+    if (gettimeofday(&tv, NULL) != 0) {
+        return HDF_FAILURE;
+    }
+    days = (long long)tv.tv_sec / SEC_PER_DAY;
+    rem = (unsigned int)((long long)tv.tv_sec % SEC_PER_DAY);
+    HiRtcDaysToCivil(days, &y, &m, &d);
+    rt.year = (uint16_t)y;
+    rt.month = (uint8_t)m;
+    rt.day = (uint8_t)d;
+    rt.weekday = (uint8_t)((days + RTC_WEEKDAY_EPOCH_OFFSET) % DAYS_PER_WEEK + 1); /* 1-7=Mon-Sun */
+    rt.hour = (uint8_t)(rem / SEC_PER_HOUR);
+    rt.minute = (uint8_t)((rem % SEC_PER_HOUR) / SEC_PER_MIN);
+    rt.second = (uint8_t)(rem % SEC_PER_MIN);
+    rt.millisecond = 0;
+    if (HiRtcWriteTime(g_rtcTimeSyncHost, &rt) != HDF_SUCCESS) {
+        HDF_LOGE("[AOV-TIME] ntp writeback rtc fail");
+        return HDF_FAILURE;
+    }
+    HDF_LOGI("[AOV-TIME] ntp writeback rtc ok");
+    return HDF_SUCCESS;
+}
+
+/* AOV T4b：读 RTC 为 epoch 秒，供 pm 平台 deep 钩子（pm_hi35xx.c）弱引用，
+ * 计算深睡期间 CNTPCT 丢失的时间并补偿内核 offset */
+int Hi35xxRtcReadEpoch(long long *epochSec)
+{
+    struct RtcTime rt;
+    long long days;
+
+    if ((g_rtcTimeSyncHost == NULL) || (epochSec == NULL)) {
+        return HDF_FAILURE;
+    }
+    if (HiRtcReadTime(g_rtcTimeSyncHost, &rt) != HDF_SUCCESS) {
+        return HDF_FAILURE;
+    }
+    if (rt.year < RTC_TIME_YEAR_START || rt.year > RTC_TIME_YEAR_END) {
+        return HDF_FAILURE;
+    }
+    days = HiRtcCivilToDays(rt.year, rt.month, rt.day);
+    *epochSec = days * SEC_PER_DAY + rt.hour * SEC_PER_HOUR + rt.minute * SEC_PER_MIN + rt.second;
+    return HDF_SUCCESS;
+}
+
 static int32_t HiRtcInit(struct HdfDeviceObject *device)
 {
     struct RtcHost *host = NULL;
@@ -834,6 +976,8 @@ static int32_t HiRtcInit(struct HdfDeviceObject *device)
 
     host->method = &g_method;
     host->data = rtcInfo;
+    g_rtcTimeSyncHost = host;
+    HiRtcSyncSystemTime(host); /* AOV T4: 开机 RTC→系统时间（录像时间轴起点） */
     HDF_LOGI("Hdf dev service:%s init success!", HdfDeviceGetServiceName(device));
     return HDF_SUCCESS;
 }
diff --git a/hi3516dv300/sdk_liteos/mpp/module_init/src/sdk_init.c b/hi3516dv300/sdk_liteos/mpp/module_init/src/sdk_init.c
index 95a26065..fe63ddf4 100644
--- a/hi3516dv300/sdk_liteos/mpp/module_init/src/sdk_init.c
+++ b/hi3516dv300/sdk_liteos/mpp/module_init/src/sdk_init.c
@@ -20,6 +20,21 @@
 #include "fcntl.h"
 #include "string.h"
 
+#include "los_sys.h"
