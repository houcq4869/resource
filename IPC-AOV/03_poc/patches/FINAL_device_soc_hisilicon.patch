+static int TimedInit(const char *name, int (*initFn)(void))
+{
+    unsigned int t0 = (unsigned int)LOS_TickCountGet();
+    int ret = initFn();
+    unsigned int cost = (unsigned int)LOS_TickCountGet() - t0;
+    printf("[TTFF] %-8s cost %u ms ret %d\n", name, cost, ret);
+    if (ret != 0) {
+        printf("%s init error.\n", name);
+    }
+    return ret;
+}
