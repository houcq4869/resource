+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * AOV PoC T5：值守单帧循环业务骨架（阶段4 §3.5 落地载体）
+ *
+ * 循环（值守态，间隔可配 1~60s）：
+ *   SNAP 单帧触发 → VENC 取流 → MD 检测(桩) → 攒批缓存 → 满批/定时 flush 落盘(fsync)
+ *   → sleep(interval)【期间内核 idle PM 钩子自动挂起 CPU，T2/T3 链路】
+ *   MD 命中 → ACTIVE 突发：连续取流 N 秒(滞回) → 回值守
+ *
+ * 运行方式（PoC 手动启动，不进 init cfg）：
+ *   aov_poc [-i 值守间隔秒] [-d 总时长秒,0=无限] [-o 输出目录]
+ * 前置：media_server 可并存（不打开 camera 客户端即无管线冲突）；SD 卡已挂载 /sdcard。
+ *
+ * 硬件联调项（代码内以 [TUNE] 标注）：
+ *   1. MIPI RX/sensor 时钟配置：本骨架未调用 MIPI RX attr API（user 态头 hi_mipi.h 在位，
+ *      但 lane/时钟参数依赖板级联调；若 camera HAL 未预配置需在此补齐）
+ *   2. SNAP 模式下 ISP 3A 策略：当前 ISP Run 线程常驻（保出图）；功耗优化第二步切
+ *      RunOnce + 曝光参数缓存（kol Fast AE 模式，阶段1报告 §2.2）
+ *   3. sensor standby/restart：pfnStandby 钩子在预编译 libsns 内，触发路径联调期确认
+ *   4. MD 检测：当前为桩（固定间隔缩时模式，业界有效形态之一）；第二步接 libmd/IVE/NNIE
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <pthread.h>
+#include <getopt.h>
+#include <time.h>
+#include <sys/time.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <errno.h>
+
+#include "hi_common.h"
+#include "hi_comm_video.h"
+#include "hi_comm_vi.h"
+#include "hi_comm_isp.h"
+#include "hi_comm_sns.h"
+#include "hi_sns_ctrl.h"
+#include "hi_comm_venc.h"
+#include "hi_comm_snap.h"
+#include "hi_comm_3a.h"
+#include "hi_ae_comm.h"
+#include "hi_awb_comm.h"
+#include "mpi_sys.h"
+#include "mpi_vi.h"
+#include "mpi_isp.h"
+#include "mpi_ae.h"
+#include "mpi_awb.h"
+#include "mpi_venc.h"
+#include "mpi_snap.h"
+#include "mpi_vb.h"
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif
+
+/* imx335 sensor 对象（libsns_imx335 导出，sample_comm_isp 同款引用） */
+extern ISP_SNS_OBJ_S stSnsImx335Obj;
+
+/* ==================== 配置宏（[TUNE] 联调期按实测调整） ==================== */
+#define AOV_VI_DEV              0
+#define AOV_VI_PIPE             0
+#define AOV_VI_CHN              0
+#define AOV_VENC_CHN            0
+
+#define AOV_SNS_WIDTH           2592   /* imx335 4M sensor 全尺寸 */
+#define AOV_SNS_HEIGHT          1944
+#define AOV_PIC_WIDTH           1920   /* 值守/事件编码尺寸 [TUNE] */
+#define AOV_PIC_HEIGHT          1080
+#define AOV_FPS                 30
+
+#define AOV_BITRATE_KBPS        512    /* 值守低码率 [TUNE]：1fps 缩时下实际码率远低于此上限 */
+#define AOV_GOP                 60
+#define AOV_VENC_BUF_SIZE       (512 * 1024)
+
+#define AOV_BATCH_BYTES         (1024 * 1024)          /* 攒批 1MB 落盘（kol 同款策略） */
+#define AOV_SEGMENT_FRAMES      3600                   /* 每段文件帧数上限（缩时 1fps≈1h/段） */
+#define AOV_OUT_DIR_DEFAULT     "/sdcard/aov"
+#define AOV_OUT_NAME_LEN        128
+
+#define AOV_INTERVAL_DEFAULT_S  1                      /* 值守间隔（秒，可配范围 1~60） */
+#define AOV_ACTIVE_DURATION_S   15                     /* 事件突发录像时长 */
+#define AOV_ACTIVE_HYSTERESIS   5                      /* 连续 N 帧无目标退回值守（业界同款） */
+#define AOV_STAT_PERIOD         64                     /* 每 64 周期打印统计 */
+
+#define AOV_GETSTREAM_TIMEOUT   500                    /* ms */
+#define AOV_CHECK_RET(expr, fmt, ...) do { \
+    HI_S32 _s32Ret = (expr); \
+    if (_s32Ret != HI_SUCCESS) { \
+        printf("[AOV] " fmt " failed ret=0x%x @%s:%d\n", ##__VA_ARGS__, _s32Ret, __func__, __LINE__); \
+        return _s32Ret; \
+    } \
+} while (0)
+
+/* ==================== 全局状态 ==================== */
+static volatile int g_aovRunning = 1;
+static pthread_t g_ispThread;
+static int g_ispThreadStarted = 0;
+
+typedef struct {
+    int intervalMs;         /* 值守间隔 */
+    int durationS;          /* 总时长（0=无限） */
+    char outDir[AOV_OUT_NAME_LEN];
+    /* 运行统计 */
+    unsigned long cycles;
+    unsigned long frames;
+    unsigned long bytes;
+    unsigned long flushes;
+    unsigned long activeEntries;
+    unsigned int cycleCostMaxMs;
+    /* 攒批缓存 */
+    unsigned char *batchBuf;
+    unsigned int batchLen;
+    unsigned int segFrames;
+    unsigned int segIndex;
+    /* Fixes: Kimi/02_代码审查报告.md #M8 (2026-09-17)：段路径跨 flush 持久化，
+     * 新段开启时请求 IDR 保证段首即关键帧（可独立回放） */
+    char segPath[AOV_OUT_NAME_LEN];
+    HI_BOOL needIdr;
+    unsigned int getStreamErrs; /* GetStream 连续错误计数（超时无帧不计） */
+} AovCtx;
+
+static AovCtx g_ctx;
+
+/* ==================== ISP ==================== */
+static void *AovIspRunThread(void *arg)
+{
+    (void)arg;
+    /* [TUNE] 第二步：值守期改 HI_MPI_ISP_RunOnce + 曝光缓存（kol Fast AE），降 3A 常驻功耗 */
+    if (HI_MPI_ISP_Run(AOV_VI_PIPE) != HI_SUCCESS) {
+        printf("[AOV] isp run exit abnormally\n");
+    }
+    return NULL;
+}
+
+static HI_S32 AovIspSetup(void)
+{
+    HI_S32 s32Ret;
+    ALG_LIB_S stAeLib;
+    ALG_LIB_S stAwbLib;
+    ISP_SNS_ATTR_INFO_S stSnsAttrInfo;
+    ISP_PUB_ATTR_S stPubAttr;
+    pthread_attr_t attr;
+
+    /* AE/AWB 算法库注册（sample_comm_isp 同款） */
+    stAeLib.s32Id = AOV_VI_PIPE;
+    stAwbLib.s32Id = AOV_VI_PIPE;
+    (void)strncpy(stAeLib.acLibName, HI_AE_LIB_NAME, sizeof(stAeLib.acLibName) - 1);
+    (void)strncpy(stAwbLib.acLibName, HI_AWB_LIB_NAME, sizeof(stAwbLib.acLibName) - 1);
+    AOV_CHECK_RET(HI_MPI_AE_Register(AOV_VI_PIPE, &stAeLib), "AE register");
+    AOV_CHECK_RET(HI_MPI_AWB_Register(AOV_VI_PIPE, &stAwbLib), "AWB register");
+
+    /* sensor 总线与回调注册 */
+    (void)memset(&stSnsAttrInfo, 0, sizeof(stSnsAttrInfo));
+    stSnsAttrInfo.eSensorId = 0;     /* [TUNE] sensor id 按板级配置 */
+    if (stSnsImx335Obj.pfnSetBusInfo != HI_NULL) {
+        ISP_SNS_COMMBUS_U uBus;
+        (void)memset(&uBus, 0, sizeof(uBus));
+        uBus.s8I2cDev = 0;           /* [TUNE] i2c dev 号按板级（hcs sensor 配置）*/
+        s32Ret = stSnsImx335Obj.pfnSetBusInfo(AOV_VI_PIPE, uBus);
+        if (s32Ret != HI_SUCCESS) {
+            printf("[AOV] sns set bus failed 0x%x\n", s32Ret);
+        }
+    }
+    if (stSnsImx335Obj.pfnRegisterCallback != HI_NULL) {
+        AOV_CHECK_RET(stSnsImx335Obj.pfnRegisterCallback(AOV_VI_PIPE, &stAeLib, &stAwbLib),
+            "sns reg callback");
+    }
+    AOV_CHECK_RET(HI_MPI_ISP_SensorRegCallBack(AOV_VI_PIPE, &stSnsAttrInfo, &stSnsImx335Obj),
+        "isp sensor regcb");
+
+    /* ISP pub attr：imx335 4M -> 输出窗口全幅 [TUNE] 值守可缩小 */
+    (void)memset(&stPubAttr, 0, sizeof(stPubAttr));
+    stPubAttr.stWndRect.s32X = 0;
+    stPubAttr.stWndRect.s32Y = 0;
+    stPubAttr.stWndRect.u32Width = AOV_SNS_WIDTH;
+    stPubAttr.stWndRect.u32Height = AOV_SNS_HEIGHT;
+    stPubAttr.stSnsSize.u32Width = AOV_SNS_WIDTH;
+    stPubAttr.stSnsSize.u32Height = AOV_SNS_HEIGHT;
+    stPubAttr.f32FrameRate = (HI_FLOAT)AOV_FPS;
+    stPubAttr.enBayer = BAYER_RGGB;
+    stPubAttr.enWDRMode = WDR_MODE_NONE;
+    AOV_CHECK_RET(HI_MPI_ISP_SetPubAttr(AOV_VI_PIPE, &stPubAttr), "isp set pub attr");
+
+    AOV_CHECK_RET(HI_MPI_ISP_MemInit(AOV_VI_PIPE), "isp mem init");
+    AOV_CHECK_RET(HI_MPI_ISP_Init(AOV_VI_PIPE), "isp init");
+
+    (void)pthread_attr_init(&attr);
+    s32Ret = pthread_create(&g_ispThread, &attr, AovIspRunThread, NULL);
+    (void)pthread_attr_destroy(&attr);
+    if (s32Ret != 0) {
+        printf("[AOV] isp thread create failed %d\n", s32Ret);
+        return HI_FAILURE;
+    }
+    g_ispThreadStarted = 1;
+    return HI_SUCCESS;
+}
+
+static void AovIspStop(void)
+{
+    ALG_LIB_S stAeLib;
+    ALG_LIB_S stAwbLib;
+
+    if (!g_ispThreadStarted) {
+        return;
+    }
+    (void)HI_MPI_ISP_Exit(AOV_VI_PIPE);
+    (void)pthread_join(g_ispThread, NULL);
+    g_ispThreadStarted = 0;
+
+    stAeLib.s32Id = AOV_VI_PIPE;
+    stAwbLib.s32Id = AOV_VI_PIPE;
+    (void)strncpy(stAeLib.acLibName, HI_AE_LIB_NAME, sizeof(stAeLib.acLibName) - 1);
+    (void)strncpy(stAwbLib.acLibName, HI_AWB_LIB_NAME, sizeof(stAwbLib.acLibName) - 1);
+    if (stSnsImx335Obj.pfnUnRegisterCallback != HI_NULL) {
+        (void)stSnsImx335Obj.pfnUnRegisterCallback(AOV_VI_PIPE, &stAeLib, &stAwbLib);
+    }
+    (void)HI_MPI_AWB_UnRegister(AOV_VI_PIPE, &stAwbLib);
+    (void)HI_MPI_AE_UnRegister(AOV_VI_PIPE, &stAeLib);
+}
+
+/* ==================== VI（dev/pipe/snap/chn） ==================== */
+static HI_S32 AovViStart(void)
+{
+    VI_DEV_ATTR_S stDevAttr;
+    VI_PIPE_ATTR_S stPipeAttr;
+    VI_CHN_ATTR_S stChnAttr;
+    SNAP_ATTR_S stSnapAttr;
+
+    /* [TUNE] MIPI RX attr 未配置：若 camera HAL 未预先配置 MIPI/lane，
+     * 需按 hi_mipi.h + 板级 imx335 4lane 参数在此补齐（硬件联调项 #1） */
+
+    (void)memset(&stDevAttr, 0, sizeof(stDevAttr));
+    stDevAttr.enIntfMode = VI_MODE_MIPI;
+    stDevAttr.enWorkMode = VI_WORK_MODE_1Multiplex;
+    stDevAttr.enScanMode = VI_SCAN_PROGRESSIVE;
+    stDevAttr.as32AdChnId[0] = -1;
+    stDevAttr.as32AdChnId[1] = -1;
+    stDevAttr.as32AdChnId[2] = -1;
+    AOV_CHECK_RET(HI_MPI_VI_SetDevAttr(AOV_VI_DEV, &stDevAttr), "vi set dev attr");
+    AOV_CHECK_RET(HI_MPI_VI_EnableDev(AOV_VI_DEV), "vi enable dev");
+
+    (void)memset(&stPipeAttr, 0, sizeof(stPipeAttr));
+    stPipeAttr.enPipeBypassMode = VI_PIPE_BYPASS_NONE;
+    stPipeAttr.bYuvSkip = HI_FALSE;
+    stPipeAttr.bIspBypass = HI_FALSE;
+    stPipeAttr.u32MaxW = AOV_SNS_WIDTH;
+    stPipeAttr.u32MaxH = AOV_SNS_HEIGHT;
+    stPipeAttr.enPixFmt = PIXEL_FORMAT_RGB_BAYER_10BPP;
+    stPipeAttr.enCompressMode = COMPRESS_MODE_NONE;
+    stPipeAttr.enBitWidth = DATA_BITWIDTH_10;
+    stPipeAttr.bNrEn = HI_FALSE;
+    stPipeAttr.bSharpenEn = HI_FALSE;
+    stPipeAttr.stFrameRate.s32SrcFrameRate = AOV_FPS;
+    stPipeAttr.stFrameRate.s32DstFrameRate = AOV_FPS;
+    AOV_CHECK_RET(HI_MPI_VI_CreatePipe(AOV_VI_PIPE, &stPipeAttr), "vi create pipe");
+
+    /* SNAP 属性：普通抓拍、非 ZSL、深度 1、每触发取 1 帧（AOV 单帧核心配置） */
+    (void)memset(&stSnapAttr, 0, sizeof(stSnapAttr));
+    stSnapAttr.enSnapType = SNAP_TYPE_NORMAL;
+    stSnapAttr.bLoadCCM = HI_FALSE;
+    stSnapAttr.stNormalAttr.bZSL = HI_FALSE;
+    stSnapAttr.stNormalAttr.u32FrameDepth = 1;
+    stSnapAttr.stNormalAttr.u32RollbackMs = 0;
+    stSnapAttr.stNormalAttr.u32Interval = 1;
+    AOV_CHECK_RET(HI_MPI_SNAP_SetPipeAttr(AOV_VI_PIPE, &stSnapAttr), "snap set pipe attr");
+    AOV_CHECK_RET(HI_MPI_SNAP_EnablePipe(AOV_VI_PIPE), "snap enable pipe");
+
+    AOV_CHECK_RET(HI_MPI_VI_StartPipe(AOV_VI_PIPE), "vi start pipe");
+
+    (void)memset(&stChnAttr, 0, sizeof(stChnAttr));
+    stChnAttr.stSize.u32Width = AOV_PIC_WIDTH;
+    stChnAttr.stSize.u32Height = AOV_PIC_HEIGHT;
+    stChnAttr.enPixelFormat = PIXEL_FORMAT_YVU_SEMIPLANAR_420;
+    stChnAttr.enDynamicRange = DYNAMIC_RANGE_SDR8;
+    stChnAttr.enVideoFormat = VIDEO_FORMAT_LINEAR;
+    stChnAttr.stFrameRate.s32SrcFrameRate = AOV_FPS;
+    stChnAttr.stFrameRate.s32DstFrameRate = AOV_FPS;
+    stChnAttr.u32Depth = 1;
+    AOV_CHECK_RET(HI_MPI_VI_SetChnAttr(AOV_VI_PIPE, AOV_VI_CHN, &stChnAttr), "vi set chn attr");
+    AOV_CHECK_RET(HI_MPI_VI_EnableChn(AOV_VI_PIPE, AOV_VI_CHN), "vi enable chn");
+    return HI_SUCCESS;
+}
+
+static void AovViStop(void)
+{
+    (void)HI_MPI_VI_DisableChn(AOV_VI_PIPE, AOV_VI_CHN);
+    (void)HI_MPI_SNAP_DisablePipe(AOV_VI_PIPE);
+    (void)HI_MPI_VI_StopPipe(AOV_VI_PIPE);
+    (void)HI_MPI_VI_DestroyPipe(AOV_VI_PIPE);
+    (void)HI_MPI_VI_DisableDev(AOV_VI_DEV);
+}
+
+/* ==================== VENC（H.264 单通道） ==================== */
+static HI_S32 AovVencStart(void)
+{
+    VENC_CHN_ATTR_S stChnAttr;
+    MPP_CHN_S stSrcChn;
+    MPP_CHN_S stDestChn;
+    VENC_RECV_PIC_PARAM_S stRecvParam;
+
+    (void)memset(&stChnAttr, 0, sizeof(stChnAttr));
+    stChnAttr.stVencAttr.enType = PT_H264;
+    stChnAttr.stVencAttr.u32Profile = 0;
+    stChnAttr.stVencAttr.u32MaxPicWidth = AOV_PIC_WIDTH;
+    stChnAttr.stVencAttr.u32MaxPicHeight = AOV_PIC_HEIGHT;
+    stChnAttr.stVencAttr.u32PicWidth = AOV_PIC_WIDTH;
+    stChnAttr.stVencAttr.u32PicHeight = AOV_PIC_HEIGHT;
+    stChnAttr.stVencAttr.u32BufSize = AOV_VENC_BUF_SIZE;
+    stChnAttr.stRcAttr.enRcMode = VENC_RC_MODE_H264CBR;
+    stChnAttr.stRcAttr.stH264Cbr.u32Gop = AOV_GOP;
+    stChnAttr.stRcAttr.stH264Cbr.u32StatTime = 1;
+    stChnAttr.stRcAttr.stH264Cbr.u32SrcFrameRate = AOV_FPS;
+    stChnAttr.stRcAttr.stH264Cbr.fr32DstFrameRate = (HI_FR32)AOV_FPS;
+    stChnAttr.stRcAttr.stH264Cbr.u32BitRate = AOV_BITRATE_KBPS;
+    AOV_CHECK_RET(HI_MPI_VENC_CreateChn(AOV_VENC_CHN, &stChnAttr), "venc create");
+
+    stSrcChn.enModId = HI_ID_VI;
+    stSrcChn.s32DevId = AOV_VI_PIPE;
+    stSrcChn.s32ChnId = AOV_VI_CHN;
+    stDestChn.enModId = HI_ID_VENC;
+    stDestChn.s32DevId = 0;
+    stDestChn.s32ChnId = AOV_VENC_CHN;
+    AOV_CHECK_RET(HI_MPI_SYS_Bind(&stSrcChn, &stDestChn), "sys bind vi->venc");
+
+    /* 值守态：每触发接收 1 帧（与 SNAP Trigger 配对）；ACTIVE 态改为 -1 连续接收 */
+    (void)memset(&stRecvParam, 0, sizeof(stRecvParam));
+    stRecvParam.s32RecvPicNum = 1;
+    AOV_CHECK_RET(HI_MPI_VENC_StartRecvFrame(AOV_VENC_CHN, &stRecvParam), "venc start recv");
+    return HI_SUCCESS;
+}
+
+static void AovVencStop(void)
+{
+    MPP_CHN_S stSrcChn;
+    MPP_CHN_S stDestChn;
+
+    (void)HI_MPI_VENC_StopRecvFrame(AOV_VENC_CHN);
+    stSrcChn.enModId = HI_ID_VI;
+    stSrcChn.s32DevId = AOV_VI_PIPE;
+    stSrcChn.s32ChnId = AOV_VI_CHN;
+    stDestChn.enModId = HI_ID_VENC;
+    stDestChn.s32DevId = 0;
+    stDestChn.s32ChnId = AOV_VENC_CHN;
+    (void)HI_MPI_SYS_UnBind(&stSrcChn, &stDestChn);
+    (void)HI_MPI_VENC_DestroyChn(AOV_VENC_CHN);
+}
+
+/* ACTIVE 态切换：连续接收（事件录像）；退回值守重新置 1 帧接收 */
+static HI_S32 AovVencSetActive(HI_BOOL active)
+{
+    VENC_RECV_PIC_PARAM_S stRecvParam;
+
+    (void)memset(&stRecvParam, 0, sizeof(stRecvParam));
+    stRecvParam.s32RecvPicNum = active ? -1 : 1;
+    AOV_CHECK_RET(HI_MPI_VENC_StopRecvFrame(AOV_VENC_CHN), "venc stop recv");
+    AOV_CHECK_RET(HI_MPI_VENC_StartRecvFrame(AOV_VENC_CHN, &stRecvParam), "venc restart recv");
+    if (active) {
+        (void)HI_MPI_VENC_RequestIDR(AOV_VENC_CHN, HI_TRUE);
+    }
+    return HI_SUCCESS;
+}
+
+/* ==================== sensor 低功耗（pfnStandby/pfnRestart，kol SINGLE 模式同款机制） ==================== */
+#define AOV_SENSOR_STANDBY_EN   1
+#define AOV_SENSOR_RESTART_STABLE_MS 100  /* [TUNE] restart 后稳定延时：帧消隐≥33ms + AE 收敛余量，联调期按 Fast AE 实测收紧 */
+
+static void AovSensorRestart(void)
+{
+#if AOV_SENSOR_STANDBY_EN
+    if (stSnsImx335Obj.pfnRestart != HI_NULL) {
+        stSnsImx335Obj.pfnRestart(AOV_VI_PIPE);
+    }
+    usleep(AOV_SENSOR_RESTART_STABLE_MS * 1000);
+#endif
+}
+
+static void AovSensorStandby(void)
+{
+#if AOV_SENSOR_STANDBY_EN
+    if (stSnsImx335Obj.pfnStandby != HI_NULL) {
+        stSnsImx335Obj.pfnStandby(AOV_VI_PIPE);
+    }
+#endif
+}
+
+/* ==================== MD 检测（桩，第二步接 libmd/IVE/NNIE） ==================== */
+static HI_BOOL AovMdCheck(const VIDEO_FRAME_INFO_S *frame)
+{
+    (void)frame;
+    /* [TUNE] 第二步：768x448 子流 + libmd(HI_MD_*)/IVE 帧差/NNIE 人形。
+     * 当前桩返回无事件 → 纯缩时录像模式（业界有效形态：君正 0.5~4fps 缩时） */
+    return HI_FALSE;
+}
+
+/* ==================== 存储：时间戳分段 + 攒批 + fsync ==================== */
+static HI_S32 AovSegmentPath(char *path, unsigned int len)
+{
+    struct timeval tv;
+    struct tm tmNow;
+    int n;
+
+    (void)gettimeofday(&tv, NULL);
+    (void)localtime_r((time_t *)&tv.tv_sec, &tmNow);
+    n = snprintf(path, len, "%s/aov_%04d%02d%02d_%02d%02d%02d_%03u.h264",
+        g_ctx.outDir, tmNow.tm_year + 1900, tmNow.tm_mon + 1, tmNow.tm_mday,
+        tmNow.tm_hour, tmNow.tm_min, tmNow.tm_sec, g_ctx.segIndex);
+    return (n > 0 && (unsigned int)n < len) ? HI_SUCCESS : HI_FAILURE;
+}
+
+/* 段内写入：短写重试 + fsync（Fixes: Kimi/02 #M8 短写静默丢数据问题） */
+static HI_S32 AovWriteToSeg(const unsigned char *data, unsigned int len)
+{
+    int fd;
+    unsigned int done = 0;
+
+    if (g_ctx.segPath[0] == '\0' && AovSegmentPath(g_ctx.segPath, sizeof(g_ctx.segPath)) != HI_SUCCESS) {
+        return HI_FAILURE;
+    }
+    fd = open(g_ctx.segPath, O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0) {
+        printf("[AOV] open %s failed\n", g_ctx.segPath);
+        return HI_FAILURE;
+    }
+    while (done < len) {
+        ssize_t w = write(fd, data + done, len - done);
+        if (w <= 0) {
+            printf("[AOV] write failed %u/%u\n", done, len);
+            (void)close(fd);
+            return HI_FAILURE;
+        }
+        done += (unsigned int)w;
+    }
+    if (fsync(fd) != 0) {
+        printf("[AOV] fsync %s failed\n", g_ctx.segPath);
+        (void)close(fd);
+        return HI_FAILURE;
+    }
+    (void)close(fd);
+    g_ctx.bytes += len;
+    return HI_SUCCESS;
+}
+
+/* 攒批 flush：写段文件（休眠前/满批/事件时调用，减少 SD IO 唤醒次数） */
+static HI_S32 AovBatchFlush(void)
+{
+    if (g_ctx.batchLen == 0) {
+        return HI_SUCCESS;
+    }
+    if (AovWriteToSeg(g_ctx.batchBuf, g_ctx.batchLen) != HI_SUCCESS) {
+        return HI_FAILURE;
+    }
+    g_ctx.flushes++;
+    g_ctx.batchLen = 0;
+    /* Fixes: Kimi/02 #M8 —— segFrames 现按帧计数（在 GetStream 成功处递增），
+     * 段滚动时换新文件名并请求 IDR，保证每段可独立解码 */
+    if (g_ctx.segFrames >= AOV_SEGMENT_FRAMES) {
+        g_ctx.segFrames = 0;
+        g_ctx.segIndex++;
+        g_ctx.segPath[0] = '\0';
+        g_ctx.needIdr = HI_TRUE;
+    }
+    return HI_SUCCESS;
+}
+
+static HI_S32 AovBatchAppend(const HI_U8 *data, HI_U32 len)
+{
+    /* Fixes: Kimi/02 #M8 —— 单 pack 超批容量时绕过攒批直写，防御堆溢出 */
+    if (len > AOV_BATCH_BYTES) {
+        AOV_CHECK_RET(AovBatchFlush(), "batch flush");
+        return AovWriteToSeg(data, len);
+    }
+    if (g_ctx.batchLen + len > AOV_BATCH_BYTES) {
+        AOV_CHECK_RET(AovBatchFlush(), "batch flush");
+    }
+    (void)memcpy(g_ctx.batchBuf + g_ctx.batchLen, data, len);
+    g_ctx.batchLen += len;
+    return HI_SUCCESS;
+}
+
+/* ==================== 取流（单帧/连续共用） ==================== */
+static HI_S32 AovGetStreamOnce(HI_BOOL *gotFrame, VIDEO_FRAME_INFO_S *mdFrame)
+{
+    VENC_STREAM_S stStream;
+    HI_S32 s32Ret;
+    HI_U32 i;
+
+    *gotFrame = HI_FALSE;
+    (void)memset(&stStream, 0, sizeof(stStream));
+    /* Fixes: Kimi/02 #M8 —— 新段开启首帧请求 IDR，保证段首为关键帧 */
+    if (g_ctx.needIdr) {
+        (void)HI_MPI_VENC_RequestIDR(AOV_VENC_CHN, HI_TRUE);
+        g_ctx.needIdr = HI_FALSE;
+    }
+    s32Ret = HI_MPI_VENC_GetStream(AOV_VENC_CHN, &stStream, AOV_GETSTREAM_TIMEOUT);
+    if (s32Ret != HI_SUCCESS) {
+        /* Fixes: Kimi/02 轻微项 —— 错误不再全吞：超时无帧属值守常态，
+         * 其余错误计数并周期打印，避免 VENC 通道死亡后静默空转 */
+        g_ctx.getStreamErrs++;
+        if ((g_ctx.getStreamErrs % AOV_STAT_PERIOD) == 1) {
+            printf("[AOV] get stream err ret=0x%x (total %u)\n", s32Ret, g_ctx.getStreamErrs);
+        }
+        return HI_SUCCESS;
+    }
+    g_ctx.getStreamErrs = 0;
+    for (i = 0; i < stStream.u32PackCount; i++) {
+        VENC_PACK_S *pack = &stStream.pstPack[i];
+        if (pack->pu8Addr != NULL && pack->u32Len > 0) {
+            if (AovBatchAppend(pack->pu8Addr + pack->u32Offset,
+                               pack->u32Len - pack->u32Offset) != HI_SUCCESS) {
+                (void)HI_MPI_VENC_ReleaseStream(AOV_VENC_CHN, &stStream);
+                return HI_FAILURE;
+            }
+        }
+    }
+    (void)HI_MPI_VENC_ReleaseStream(AOV_VENC_CHN, &stStream);
+    g_ctx.frames++;
+    g_ctx.segFrames++; /* Fixes: Kimi/02 #M8 —— 段按帧计数（原实现按 flush 次数，名存实亡） */
+    *gotFrame = HI_TRUE;
+    (void)mdFrame; /* [TUNE] MD 用 VI 原始帧（GetChnFrame），阶段2 接入时补充 */
+    return HI_SUCCESS;
+}
+
+/* ==================== ACTIVE 突发录像（事件态） ==================== */
+static void AovActiveBurst(void)
+{
+    int missCnt = 0;
+    int elapsedS = 0;
+    HI_BOOL gotFrame = HI_FALSE;
+    /* Fixes: Kimi/02_代码审查报告.md #M6 (2026-09-17)
+     * 计时必须用本次 burst 起点快照——原实现用进程累计帧数折算，
+     * 累计超阈值后第二次起 ACTIVE 会第一轮即退出、滞回同时失效 */
+    unsigned long burstStartFrames;
+    unsigned long burstFrames;
+
+    g_ctx.activeEntries++;
+    burstStartFrames = g_ctx.frames;
+    printf("[AOV] -> ACTIVE burst %ds\n", AOV_ACTIVE_DURATION_S);
+    if (AovVencSetActive(HI_TRUE) != HI_SUCCESS) {
+        return;
+    }
+    while (g_aovRunning && elapsedS < AOV_ACTIVE_DURATION_S) {
+        if (AovGetStreamOnce(&gotFrame, NULL) != HI_SUCCESS) {
+            break;
+        }
+        if (gotFrame) {
+            /* [TUNE] ACTIVE 期 MD 持续检测做滞回：连续 AOV_ACTIVE_HYSTERESIS 帧无目标提前退出 */
+            if (AovMdCheck(NULL) == HI_FALSE) {
+                missCnt++;
+            } else {
+                missCnt = 0;
+            }
+            if (missCnt >= AOV_ACTIVE_HYSTERESIS * AOV_FPS) {
+                break;
+            }
+        }
+        usleep(1000 * 1000 / AOV_FPS);
+        elapsedS = (int)((g_ctx.frames - burstStartFrames) / AOV_FPS); /* 粗计时；[TUNE] 联调期换 gettimeofday 差值 */
+    }
+    (void)AovBatchFlush(); /* 事件录像立即落盘（"上传完成才可休眠"前置） */
+    (void)AovVencSetActive(HI_FALSE);
+    burstFrames = g_ctx.frames - burstStartFrames;
+    printf("[AOV] <- back to watch, burst frames=%lu\n", burstFrames);
+}
+
+/* ==================== 主循环 ==================== */
+static unsigned int AovTickMs(void)
+{
+    struct timeval tv;
+    (void)gettimeofday(&tv, NULL);
+    return (unsigned int)(tv.tv_sec * 1000 + tv.tv_usec / 1000);
+}
+
+static void AovLoop(void)
+{
+    HI_BOOL gotFrame = HI_FALSE;
+    unsigned int cycleStart;
+    unsigned int cost;
+    time_t startSec = time(NULL);
+
+    while (g_aovRunning) {
+        cycleStart = AovTickMs();
+
+        /* 1. sensor restart + 单帧触发（SNAP）：sensor 出 1 帧 → ISP → VENC 编码 */
+        AovSensorRestart();
+        if (HI_MPI_SNAP_TriggerPipe(AOV_VI_PIPE) != HI_SUCCESS) {
+            printf("[AOV] snap trigger failed\n");
+        }
+        /* 2. 取编码流 → 攒批 */
+        if (AovGetStreamOnce(&gotFrame, NULL) != HI_SUCCESS) {
+            printf("[AOV] get stream failed\n");
+        }
+        /* 3. MD 检测（桩）：命中转 ACTIVE（ACTIVE 期 sensor 保持 restart 态） */
+        if (gotFrame && AovMdCheck(NULL) == HI_TRUE) {
+            AovActiveBurst();
+        }
+        /* 4. 满批落盘 */
+        if (g_ctx.batchLen >= AOV_BATCH_BYTES) {
+            (void)AovBatchFlush();
+        }
+        /* 5. sensor standby（休眠前外设降电，阶段4 §3.5 步骤9） */
+        AovSensorStandby();
+        /* 6. 周期统计 */
+        cost = AovTickMs() - cycleStart;
+        if (cost > g_ctx.cycleCostMaxMs) {
+            g_ctx.cycleCostMaxMs = cost;
+        }
+        g_ctx.cycles++;
+        if ((g_ctx.cycles % AOV_STAT_PERIOD) == 0) {
+            printf("[AOV] cycles=%lu frames=%lu bytes=%lu flush=%u active=%u costMax=%ums\n",
+                g_ctx.cycles, g_ctx.frames, g_ctx.bytes,
+                g_ctx.flushes, g_ctx.activeEntries, g_ctx.cycleCostMaxMs);
+        }
+        /* 7. 值守间隔休眠——期间内核 idle PM 钩子自动挂起 CPU（T2/T3 链路生效点） */
+        if (g_ctx.durationS > 0 && difftime(time(NULL), startSec) >= g_ctx.durationS) {
+            break;
+        }
+        usleep((useconds_t)g_ctx.intervalMs * 1000);
+    }
+}
+
+static void AovSigHandler(int sig)
+{
+    (void)sig;
+    g_aovRunning = 0;
+}
+
+/* ==================== main ==================== */
+static void AovUsage(const char *prog)
+{
+    printf("Usage: %s [-i interval_s(1~60)] [-d duration_s(0=inf)] [-o outdir(%s)]\n",
+        prog, AOV_OUT_DIR_DEFAULT);
+}
+
+int main(int argc, char **argv)
+{
+    HI_S32 s32Ret;
+    int opt;
+    int intervalS = AOV_INTERVAL_DEFAULT_S;
+
+    (void)memset(&g_ctx, 0, sizeof(g_ctx));
+    (void)strncpy(g_ctx.outDir, AOV_OUT_DIR_DEFAULT, sizeof(g_ctx.outDir) - 1);
+    while ((opt = getopt(argc, argv, "i:d:o:h")) != -1) {
+        switch (opt) {
+            case 'i': intervalS = atoi(optarg); break;
+            case 'd': g_ctx.durationS = atoi(optarg); break;
+            case 'o': (void)strncpy(g_ctx.outDir, optarg, sizeof(g_ctx.outDir) - 1); break;
+            default: AovUsage(argv[0]); return 1;
+        }
+    }
+    if (intervalS < 1 || intervalS > 60) {
+        intervalS = AOV_INTERVAL_DEFAULT_S;
+    }
+    g_ctx.intervalMs = intervalS * 1000;
+    g_ctx.batchBuf = (unsigned char *)malloc(AOV_BATCH_BYTES);
+    if (g_ctx.batchBuf == NULL) {
+        printf("[AOV] batch buf alloc failed\n");
+        return 1;
+    }
+    if (mkdir(g_ctx.outDir, 0755) != 0 && errno != EEXIST) {
+        printf("[AOV] mkdir %s failed: %s\n", g_ctx.outDir, strerror(errno));
+        free(g_ctx.batchBuf);
+        return 1;
+    }
+
+    (void)signal(SIGINT, AovSigHandler);
+    (void)signal(SIGTERM, AovSigHandler);
+
+    printf("[AOV] start: interval=%ds duration=%ds out=%s\n",
+        intervalS, g_ctx.durationS, g_ctx.outDir);
+
+    /* MPP 用户态初始化（内核态模块已由 SDK_init 完成，此处为 SYS/VB 用户态配置） */
+    AOV_CHECK_RET(HI_MPI_SYS_Init(), "sys init");
+    /* [TUNE] VB 池：当前沿用内核 mmz 默认公共池；第二步按值守/事件双档位重配
+     * （HI_MPI_VB_SetConfig 小池 + ACTIVE 期大池，阶段3 §3 MMZ 重配方案） */
+
+    s32Ret = AovViStart();
+    if (s32Ret != HI_SUCCESS) { goto FAIL_VI; }
+    s32Ret = AovIspSetup();
+    if (s32Ret != HI_SUCCESS) { goto FAIL_ISP; }
+    s32Ret = AovVencStart();
+    if (s32Ret != HI_SUCCESS) { goto FAIL_VENC; }
+
+    AovLoop();
+
+    (void)AovBatchFlush(); /* 退出前落盘（休眠前 flush 纪律） */
+    printf("[AOV] done: cycles=%lu frames=%lu bytes=%lu flush=%u active=%u costMax=%ums\n",
+        g_ctx.cycles, g_ctx.frames, g_ctx.bytes,
+        g_ctx.flushes, g_ctx.activeEntries, g_ctx.cycleCostMaxMs);
+
+FAIL_VENC:
+    AovVencStop();
+FAIL_ISP:
+    AovIspStop();
+FAIL_VI:
+    AovViStop();
+    (void)HI_MPI_SYS_Exit();
+    free(g_ctx.batchBuf);
+    return (s32Ret == HI_SUCCESS) ? 0 : 1;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif
