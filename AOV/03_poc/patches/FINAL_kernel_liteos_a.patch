+
+/*
+ * AOV PoC T4：SNTP 移植层（时间连续性方案的网络对时半边）。
+ *
+ * 背景：内核 lwip 实际经 Makefile 构建，LOCAL_SRCS 仅含 porting/src 目录通配与
+ * lwip 官方源（LWIPNOAPPSFILES）——enhancement/src（fixme.c/api_shell.c）
+ * 不参与编译，故基线镜像中 lwip_sntp_start 空桩与 ntpdate 命令均不存在
+ * （阶段2 "NTP 链路断" 的构建级根因）。本文件位于 porting/src/（wildcard
+ * 自动编入），自包含提供：
+ *   - lwip_sntp_start()：启动 SNTP 并同步等待首次校时（供产品代码/shell 调用）
+ *   - LwipSntpSetSystemTime()：SNTP_SET_SYSTEM_TIME 宏回调（lwipopts.h 定义），
+ *     settimeofday + 弱引用回写 RTC（Hi35xxRtcWriteSysTime，rtc_hi35xx.c 提供）
+ *   - ntpdate shell 命令（LOSCFG_SHELL_CMD_DEBUG 下注册，自包含不依赖 api_shell.c）
+ *
+ * sntp.c 本体（third_party/lwip/src/apps/sntp/）已随本补丁编入
+ * （Makefile LOCAL_SRCS += 与 BUILD.gn sources +=）。
+ */
+
+#include "lwip/opt.h"
+
+#if LWIP_SNTP
+
+#include <string.h>
+#include <time.h>
+#include <sys/time.h>
+#include "lwip/apps/sntp.h"
+#include "lwip/netif.h"
+#include "los_task.h"
+#include "los_printf.h"
+#include "shcmd.h"
+#include "shell.h"
+
+/* RTC 回写弱引用：vendor rtc 驱动（rtc_hi35xx.c）提供强实现；未提供时为 NULL */
+extern int Hi35xxRtcWriteSysTime(void) __attribute__((weak));
+
+#define LWIP_SNTP_NAME_LEN          64
+#define LWIP_SNTP_POLL_INTERVAL_MS  10   /* LOS_TaskDelay 单位 tick，本配置 1tick=1ms */
+#define LWIP_SNTP_SYNC_TIMEOUT_MS   10000
+
+/* sntp_setservername 仅保存指针不拷贝，shell argv 生命周期短，
+ * 且 SNTP_UPDATE_DELAY 周期校时会再次解引用服务器名，必须静态持久化 */
+static char g_sntpServerNames[SNTP_MAX_SERVERS][LWIP_SNTP_NAME_LEN];
+
+void LwipSntpSetSystemTime(unsigned int sec)
+{
+    struct timeval tv;
+
+    tv.tv_sec = (time_t)sec;
+    tv.tv_usec = 0;
+    (void)settimeofday(&tv, NULL);
+
+    if (Hi35xxRtcWriteSysTime != NULL) {
+        (void)Hi35xxRtcWriteSysTime(); /* 校时后回写 RTC，掉电重启不丢时间 */
+    }
+}
+
+int lwip_sntp_start(int server_num, char **sntp_server, struct timeval *time)
+{
+    int i;
+    int synced = -1;
+    unsigned int waited = 0;
+    struct timeval t0;
+    struct timeval t1 = {0};
+
+    if ((server_num <= 0) || (sntp_server == NULL) || (time == NULL)) {
+        return -1;
+    }
+
+    (void)gettimeofday(&t0, NULL);
+
+    sntp_stop();
+    sntp_setoperatingmode(SNTP_OPMODE_POLL);
+    for (i = 0; (i < server_num) && (i < SNTP_MAX_SERVERS); i++) {
+        (void)strncpy(g_sntpServerNames[i], sntp_server[i], LWIP_SNTP_NAME_LEN - 1);
+        g_sntpServerNames[i][LWIP_SNTP_NAME_LEN - 1] = '\0';
+        sntp_setservername(i, g_sntpServerNames[i]);
+    }
+    sntp_init();
+
+    /* 轮询等待首次校时完成（SNTP 响应在 tcpip 上下文处理并回调宏） */
+    while (waited < LWIP_SNTP_SYNC_TIMEOUT_MS) {
+        LOS_TaskDelay(LWIP_SNTP_POLL_INTERVAL_MS);
+        waited += LWIP_SNTP_POLL_INTERVAL_MS;
+        (void)gettimeofday(&t1, NULL);
+        if (t1.tv_sec != t0.tv_sec) {
+            synced = 0; /* PoC 简化：不区分应答服务器序号，恒报首个 */
+            break;
+        }
+    }
+
+    (void)gettimeofday(time, NULL);
+    return synced;
+}
+
+#ifdef LOSCFG_SHELL_CMD_DEBUG
+static UINT32 OsShellCmdNtpdate(UINT32 argc, const CHAR **argv)
+{
+    int sync;
+    char *ret = NULL;
+    char buf[50] = {0};
+    struct timeval getTime = {0};
+
+    if ((netif_default == NULL) || !netif_is_up(netif_default)) {
+        PRINTK("ntpdate: network not ready\n");
+        return LOS_NOK;
+    }
+    if ((argc < 1) || (argv == NULL)) {
+        PRINTK("\nUsage:\n");
+        PRINTK("ntpdate [SERVER1] [SERVER2]\n");
+        return LOS_NOK;
+    }
+
+    sync = lwip_sntp_start((int)argc, (char **)argv, &getTime);
+    if (sync >= 0) {
+        ret = ctime_r((const time_t *)&getTime.tv_sec, buf);
+        if (ret != NULL) {
+            PRINTK("time synced: %s", ret); /* ctime_r 结果自带换行 */
+        } else {
+            PRINTK("ntpdate: ctime_r failed\n");
+        }
+        return LOS_OK;
+    }
+
+    PRINTK("no server suitable for synchronization found\n");
+    return LOS_NOK;
+}
+
+SHELLCMD_ENTRY(sntp_ntpdate_shellcmd, CMD_TYPE_EX, "ntpdate", XARGS, (CmdCallBackFunc)OsShellCmdNtpdate);
+#endif /* LOSCFG_SHELL_CMD_DEBUG */
+
+#endif /* LWIP_SNTP */
