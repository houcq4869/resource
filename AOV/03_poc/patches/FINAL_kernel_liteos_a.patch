+#define SNTP_SERVER_DNS                 1
+#define SNTP_MAX_SERVERS                2
+#define SNTP_UPDATE_DELAY               3600000 /* 周期校时 1h（RFC4330 下限 15s） */
+#define SNTP_SET_SYSTEM_TIME(sec)       LwipSntpSetSystemTime(sec)
